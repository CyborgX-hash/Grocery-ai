# Environment configuration for MessyList Backend
PORT=5001
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://sakshamsontakke@localhost:5432/messylist"

# Open-Weight AI Configuration (Gemma)
# When GEMMA_API_KEY is not set, MessyList seamlessly runs in intelligent DEMO MODE.
# To connect your real Gemma model, supply the credentials below:
GEMMA_API_KEY=
GEMMA_API_URL="https://api-inference.huggingface.co/models/google/gemma-2-9b-it"
# Alternative Gemma API endpoints:
# Google AI Studio: "https://generativelanguage.googleapis.com/v1beta/models/gemma-2-9b-it:generateContent"
# Self-hosted / vLLM / Ollama: "http://localhost:11434/v1/chat/completions"
GEMMA_MODEL="google/gemma-2-9b-it"
